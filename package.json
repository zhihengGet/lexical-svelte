{
	"name": "lexical-svelte-runes",
	"private": false,
	"version": "0.1.4-beta.88.3",
	"type": "module",
	"author": {
		"name": "zhiheng zhang"
	},
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"dev": "vite --port 3001",
		"build": "vite build ",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"fix": "eslint --fix .",
		"tsc": "tsc",
		"package": "svelte-package --input ./src && bunx unocss"
	},
	"exports": {
		".": {
			"svelte": "./dist/",
			"default": "./dist/*"
		},
		"./editor": {
			"svelte": "./dist/index.js",
			"default": "./dist/index",
			"types": "./dist/index.d.ts"
		},
		"./*": {
			"svelte": "./dist/*",
			"default": "./dist/*"
		},
		"./src/*": {
			"svelte": "./src/*",
			"default": "./src/*"
		},
		"./editor.css": "./src/themes/playgroundEditorTheme.css",
		"./uno.css": "./dist/uno.css"
	},
	"imports": {
		"#uno.css": {
			"default": "./uno.css"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
